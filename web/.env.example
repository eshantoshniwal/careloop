# CareLoop dashboard configuration.
#
# The dashboard signs in with a Medplum USER email and password on the in-app
# login screen and reads live FHIR data. There is deliberately no client secret
# here — the bridge's server-side credential must never reach the browser.

VITE_MEDPLUM_BASE_URL=https://api.medplum.com/
VITE_MEDPLUM_CLIENT_ID=
VITE_MEDPLUM_PROJECT_ID=

# CareLoop bridge backend (intake + outbound calling + approval).
VITE_BRIDGE_URL=http://localhost:3000

# Shared secret for the bridge's write endpoints. For local development only —
# in a real deployment the dashboard should obtain a scoped token instead of
# holding a shared secret in the browser bundle.
VITE_BRIDGE_SECRET=dev-secret
