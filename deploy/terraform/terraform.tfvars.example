# Copy to terraform.tfvars and fill in.
aws_profile       = "your-cli-profile"
region            = "us-east-1"
target_account_id = "123456789012"
assume_role_name  = "OrganizationAccountAccessRole"
instance_type     = "t3.small"

# DNS A record for this host must point at the Elastic IP before Caddy can
# issue a certificate.
domain = "bridge.example.com"

# For a private repo use a tokenized URL: https://<TOKEN>@github.com/you/repo.git
git_repo = "https://github.com/your-org/careloop.git"

env_parameter_name = "/careloop/bridge-env"
