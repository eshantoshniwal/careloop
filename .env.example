# ---- CareLoop bridge environment ----
# Copy to `.env` and fill in. Every integration degrades gracefully to a
# labelled mock when its credentials are missing, so `npm run simulate`
# runs with none of these set.

# --- App ---
PORT=3000
# Public hostname Twilio can reach (tunnel or Caddy host). No scheme.
PUBLIC_HOST=your-tunnel.example.com
# Shared secret required by the /tools endpoints.
TOOL_SHARED_SECRET=change-me
LOG_LEVEL=info

# --- Medplum (system of record, client credentials) ---
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# --- Twilio (telephony) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550000000

# --- Deepgram (voice agent: STT + LLM + TTS) ---
DEEPGRAM_API_KEY=
DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse

# --- LLM for post-call workers. LLM_PROVIDER = groq | anthropic | none ---
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# --- Moss (semantic retrieval over the patient-safe condition corpus) ---
# Run `npm run moss:index` once to create each condition index.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# --- Stedi (270/271 eligibility). Test keys start with `test_`. ---
STEDI_API_KEY=
STEDI_BASE_URL=https://healthcare.us.stedi.com
STEDI_PAYER_ID=
STEDI_PROVIDER_NPI=
STEDI_PROVIDER_NAME=
STEDI_SERVICE_TYPE=30
# A FHIR Coverage carries payer and member id but not the subscriber name and
# date of birth a complete 270 needs. These fill the gap for test/demo payers
# only — in production the subscriber must come from the record, not from here.
STEDI_SUB_FIRST_NAME=
STEDI_SUB_LAST_NAME=
STEDI_SUB_DOB=
STEDI_SUB_MEMBER_ID=

# --- Seed identifiers (populated by `npm run seed`) ---
SEED_PATIENT_ID=
SEED_CONDITION_ID=
SEED_QUESTIONNAIRE_ID=
